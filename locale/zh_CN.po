msgctxt "model:ir.message,text:msg_missing_fernet_key"
msgid "Missing Fernet key."
msgstr "缺少 Fernet 密钥。"

#, python-format
msgctxt "model:ir.message,text:msg_invalid_fernet_token"
msgid ""
"The encrypted value for \"%(field)s\" can not be decrypted with the current "
"Fernet key."
msgstr "无法使用当前 Fernet 密钥解密“%(field)s”的加密值。"

#, python-format
msgctxt "model:ir.message,text:msg_invalid_decrypted_field_name"
msgid "The field \"%(field)s\" must end with \"_decrypted\"."
msgstr "字段“%(field)s”必须以“_decrypted”结尾。"

#, python-format
msgctxt "model:ir.message,text:msg_unknown_decrypted_field"
msgid "The field \"%(field)s\" is not defined on the model."
msgstr "模型中未定义字段“%(field)s”。"
